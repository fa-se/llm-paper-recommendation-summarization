# Copy this file to .env and replace placeholders with actual values

# API Configuration
# Provide a contact email for faster OpenAlex response times (https://docs.openalex.org/how-to-use-the-api/rate-limits-and-authentication#the-polite-pool)
OPENALEX_CONTACT_EMAIL=
# API key for the OpenAI API
OPENAI_API_KEY=

# Database configuration
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# 1: log all SQL statements
DEBUG=

# Optional: other models (defaults in core/config.py), e.g. the thesis' original ones:
# OPENAI_QUALITY_MODEL=gpt-4o-2024-05-13
# OPENAI_RERANK_MODEL=gpt-4o-mini-2024-07-18
# OPENAI_QUALITY_REASONING_EFFORT=
# OPENAI_RERANK_REASONING_EFFORT=
